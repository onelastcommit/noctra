{
  "name": "noctra-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Noctra operations dashboard — Preact + esbuild, built into a single self-contained index.html embedded in the Go binary.",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "watch": "node build.mjs --watch",
    "dev": "node devserver.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
